# 1. DATABASE CONFIGURATION (MongoDB Atlas via Mongoose)
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/ksarts_textile_dss?retryWrites=true&w=majority"

# 2. CLOUDINARY CONFIGURATION (Product Fabric Image Uploads)
CLOUDINARY_CLOUD_NAME="your_cloud_name_here"
CLOUDINARY_API_KEY="your_api_key_here"
CLOUDINARY_API_SECRET="your_api_secret_here"
CLOUDINARY_URL="cloudinary://your_api_key:your_api_secret@your_cloud_name"

# 3. CLERK AUTHENTICATION CONFIGURATION (@clerk/nextjs)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_your_clerk_publishable_key_here"
CLERK_SECRET_KEY="sk_test_your_clerk_secret_key_here"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/login"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/"

# 4. PYTHON FLASK MACHINE LEARNING MICROSERVICE URL
FLASK_AI_SERVICE_URL="http://127.0.0.1:5000/api/v1/predict"

# 5. GENERAL APP CONFIGURATION
NEXT_PUBLIC_APP_URL="http://localhost:3000"
